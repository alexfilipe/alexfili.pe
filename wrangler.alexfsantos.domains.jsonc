{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "alexfsantos-domain-redirect",
  "main": "scripts/alexfsantos-redirect-worker.js",
  "compatibility_date": "2026-08-08",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "alexfsantos.com", "custom_domain": true },
    { "pattern": "www.alexfsantos.com", "custom_domain": true }
  ]
}
